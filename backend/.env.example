# ==========================================
# 模型配置
# ==========================================

# YOLOv8 模型路径（相对于 backend 目录）
# 默认使用 yolov8n.pt，可选: yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
MODEL_PATH=yolov8n.pt

# 默认置信度阈值 (0.0 - 1.0)
DEFAULT_CONFIDENCE=0.5

# ==========================================
# 目录配置
# ==========================================

# 文件上传目录
UPLOAD_DIR=uploads

# 处理结果输出目录
OUTPUT_DIR=outputs

# 模型存储目录
MODELS_DIR=models

# ==========================================
# 文件限制（可选配置）
# ==========================================

# 最大图片大小（字节）
# MAX_IMAGE_SIZE=10485760  # 10MB

# 最大视频大小（字节）
# MAX_VIDEO_SIZE=104857600  # 100MB
